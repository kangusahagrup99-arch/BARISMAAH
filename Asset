/* ==========================================================================
   BARISMA Design System — Modern Think-Tank & Academic Portal
   ATM inspired by INDEF (Institute for Development of Economics and Finance)
   Badan Riset Maqāṣid - LSQ Ar-Rohmah Yogyakarta
   ========================================================================== */

:root {
  --color-forest:       #166534; /* Emerald Green from BARISMA Logo */
  --color-forest-dark:  #0C291B; /* Dark accent */
  --color-forest-light: #F0FDF4; /* Soft mint */
  --color-amber-gold:   #D97706; /* Golden Amber from Logo */
  --color-amber-light:  #FEF3C7;
  --color-silver-grey:  #64748B; /* Silver Grey from Logo */
  --color-bg-base:      #FFFFFF;
  --color-bg-alt:       #F8FAFC;
  --color-text-main:    #0F172A;
  --color-text-muted:   #475569;
  --color-border:       #E2E8F0;
  --font-serif:         'Lora', Georgia, serif;
  --font-sans:          'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --font-arabic:        'Amiri', 'Traditional Arabic', serif;
}

body {
  font-family: var(--font-sans);
  background-color: var(--color-bg-base);
  color: var(--color-text-main);
  font-size: 16px;
  line-height: 1.75;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4, .font-serif {
  font-family: var(--font-serif);
  letter-spacing: -0.015em;
  color: var(--color-text-main);
}

.font-arabic {
  font-family: var(--font-arabic);
}

/* Modern Think-Tank Card */
.card-thinktank {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: 1rem;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.card-thinktank:hover {
  transform: translateY(-3px);
  border-color: #CBD5E1;
  box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08);
}

/* Category Badge Pills & Tags */
.badge-pill, .badge-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: 9999px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.badge-opini {
  background-color: #ECFDF5;
  color: #065F46;
  border: 1px solid #A7F3D0;
}

.badge-policy {
  background-color: #FEF3C7;
  color: #92400E;
  border: 1px solid #FDE68A;
}

.badge-kajian {
  background-color: #EFF6FF;
  color: #1E40AF;
  border: 1px solid #BFDBFE;
}

.badge-buku {
  background-color: #F8FAFC;
  color: #475569;
  border: 1px solid #E2E8F0;
}

/* Section Label Line */
.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-forest);
}
.section-tag::before {
  content: '';
  display: inline-block;
  width: 1.25rem;
  height: 2px;
  background-color: var(--color-amber-gold);
}

/* Modern Drop Cap */
.dropcap::first-letter {
  font-family: var(--font-serif);
  float: left;
  font-size: 3.5rem;
  line-height: 0.85;
  padding-top: 4px;
  padding-right: 12px;
  padding-bottom: 0;
  color: var(--color-forest);
  font-weight: 700;
}

/* Floating WhatsApp Button */
.wa-float {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 45;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  background-color: #25D366;
  color: #FFFFFF;
  border-radius: 9999px;
  font-weight: 700;
  font-size: 0.875rem;
  box-shadow: 0 10px 25px -5px rgba(37, 211, 102, 0.4);
  transition: all 0.25s ease;
}
.wa-float:hover {
  transform: translateY(-2px) scale(1.02);
  background-color: #20BA5C;
  box-shadow: 0 14px 28px -5px rgba(37, 211, 102, 0.5);
}

/* Sticky Navbar on scroll */
#mainNav.scrolled {
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(12px);
  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
}

/* ========================================================================
   BARISMA Homepage — Minimalist, Clean & Modern Sans-Serif Design
   Badan Riset Maqāṣid · PP LSQ Ar-Rohmah Yogyakarta
   ======================================================================== */

:root {
  /* Brand Palette */
  --green-950: #0a2016;
  --green-900: #103829;
  --green-800: #166534; /* Official Emerald */
  --green-700: #15803d;
  --green-600: #16a34a;
  --green-100: #dcfce7;
  --green-50:  #f0fdf4;
  --amber-600: #d97706; /* Golden Amber */
  --amber-100: #fef3c7;
  --amber-50:  #fffbeb;

  /* Neutrals */
  --slate-900: #0f172a;
  --slate-800: #1e293b;
  --slate-700: #334155;
  --slate-600: #475569;
  --slate-500: #64748b;
  --slate-400: #94a3b8;
  --slate-200: #e2e8f0;
  --slate-100: #f1f5f9;
  --slate-50:  #f8fafc;
  --white:     #ffffff;

  /* Typography: 100% Sans-Serif */
  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  
  /* Container & Radius */
  --container-max: 1180px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-full: 9999px;
  
  /* Shadows */
  --shadow-subtle: 0 1px 3px 0 rgba(15, 23, 42, 0.06), 0 1px 2px -1px rgba(15, 23, 42, 0.04);
  --shadow-card:   0 4px 16px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -2px rgba(15, 23, 42, 0.04);
  --shadow-hover:  0 12px 28px -4px rgba(15, 23, 42, 0.10), 0 4px 12px -2px rgba(15, 23, 42, 0.06);
  --shadow-dropdown: 0 20px 35px -8px rgba(15, 23, 42, 0.15), 0 8px 16px -4px rgba(15, 23, 42, 0.08);
}

/* Base Reset */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 88px; }
body {
  font-family: var(--font-sans);
  background-color: var(--white);
  color: var(--slate-900);
  font-size: 15px;
  line-height: 1.68;
  -webkit-font-smoothing: antialiased;
}
body.menu-open { overflow: hidden; }
a { color: inherit; text-decoration: none; transition: color .18s ease, background-color .18s ease; }
button { font-family: inherit; border: none; background: none; cursor: pointer; }
img { max-width: 100%; height: auto; display: block; }

.container {
  width: min(var(--container-max), calc(100% - 48px));
  margin-inline: auto;
}

/* ========================================================================
   TOP UTILITY BAR
   ======================================================================== */
.utility-bar {
  background-color: var(--slate-900);
  color: var(--slate-300);
  font-size: 13px;
  border-bottom: 1px solid var(--slate-800);
  padding: 8px 0;
}
.utility-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.utility-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.utility-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #34d399;
  display: inline-block;
  box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.2);
}
.utility-links {
  display: flex;
  align-items: center;
  gap: 20px;
  font-size: 13px;
}
.utility-links a:hover { color: #34d399; }
.utility-separator { color: var(--slate-700); }

/* ========================================================================
   SITE HEADER & NAVIGATION
   ======================================================================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--slate-200);
  transition: box-shadow .2s ease;
}
.site-header.is-scrolled {
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
}
.nav-wrap {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}
.brand {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}
.brand img {
  height: 48px;
  width: auto;
  object-fit: contain;
}

/* Desktop Primary Nav */
.primary-nav {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Nav Item & Links */
.nav-item {
  position: relative;
}
.nav-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 14px;
  border-radius: var(--radius-sm);
  color: var(--slate-700);
  font-size: 14.5px;
  font-weight: 600;
  white-space: nowrap;
  transition: all .18s ease;
}
.nav-link:hover,
.nav-item.is-active > .nav-link,
.nav-link.active {
  color: var(--green-800);
  background-color: var(--green-50);
}
.chevron-icon {
  width: 14px;
  height: 14px;
  transition: transform .2s ease;
  opacity: .7;
}
.nav-item:hover .chevron-icon,
.nav-item.is-open .chevron-icon {
  transform: rotate(180deg);
  opacity: 1;
}

/* Dropdown Menu Container (Desktop) */
.dropdown-menu {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  min-width: 260px;
  background-color: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-dropdown);
  padding: 8px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
  z-index: 120;
}
.dropdown-menu.align-right {
  left: auto;
  right: 0;
}

/* Dropdown Hover & Focus Display */
.nav-item:hover .dropdown-menu,
.nav-item:focus-within .dropdown-menu,
.nav-item.is-open .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* Dropdown Items */
.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  color: var(--slate-700);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.4;
  transition: all .15s ease;
}
.dropdown-item:hover {
  background-color: var(--green-50);
  color: var(--green-800);
  font-weight: 600;
}
.dropdown-item-badge {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: var(--radius-full);
  background-color: var(--amber-100);
  color: var(--amber-600);
  text-transform: uppercase;
}

/* Navigation Action Buttons */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: var(--radius-md);
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
  transition: all .2s ease;
}
.btn-primary {
  background-color: var(--green-800);
  color: var(--white);
  box-shadow: 0 4px 12px rgba(22, 101, 52, 0.2);
}
.btn-primary:hover {
  background-color: var(--green-700);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(22, 101, 52, 0.28);
  color: var(--white);
}
.btn-outline {
  border: 1px solid var(--slate-200);
  background-color: var(--white);
  color: var(--slate-800);
}
.btn-outline:hover {
  border-color: var(--green-800);
  color: var(--green-800);
  background-color: var(--green-50);
}
.btn-sm {
  padding: 8px 16px;
  font-size: 13.5px;
}

/* Hamburger Toggle Button */
.menu-toggle {
  display: none;
  width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-sm);
  background-color: var(--white);
  color: var(--slate-800);
}

/* ============================================================
   HERO SECTION (With Photo Documentation Slider Behind Title)
   ============================================================ */
.hero-section {
  position: relative;
  overflow: hidden;
  min-height: 600px;
  display: flex;
  align-items: center;
  background-color: var(--green-950);
  border-bottom: 1px solid var(--slate-200);
}
.hero-swiper {
  position: absolute !important;
  inset: 0 !important;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
  z-index: 1;
}
.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.hero-slide-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.92);
  transform: scale(1.03);
  transition: transform 6s ease;
}
.swiper-slide-active .hero-slide-img {
  transform: scale(1);
}
.hero-slide-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, rgba(8, 28, 19, 0.92) 0%, rgba(10, 38, 26, 0.82) 55%, rgba(12, 45, 31, 0.72) 100%);
  z-index: 2;
}

/* Hero Foreground Content */
.hero-content-layer {
  position: relative;
  z-index: 10;
  padding: 84px 0 96px;
  width: 100%;
}
.hero-content-box {
  max-width: 740px;
}
.hero-badge {
  background-color: rgba(52, 211, 153, 0.15) !important;
  color: #34d399 !important;
  border: 1px solid rgba(52, 211, 153, 0.3);
  backdrop-filter: blur(8px);
}
.hero-title-white {
  font-size: clamp(34px, 4.4vw, 50px);
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: -0.03em;
  color: var(--white);
  margin-bottom: 20px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
}
.hero-title-white span {
  color: #fbbf24; /* Warm golden amber highlight */
}
.hero-desc-white {
  font-size: 16.5px;
  line-height: 1.72;
  color: rgba(255, 255, 255, 0.88);
  margin-bottom: 34px;
  max-width: 640px;
}
.btn-hero-outline {
  border: 1px solid rgba(255, 255, 255, 0.35);
  background-color: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(8px);
  color: var(--white);
}
.btn-hero-outline:hover {
  background-color: var(--white);
  color: var(--green-900);
  border-color: var(--white);
}

/* Hero Glass Stats */
.hero-stats-glass {
  display: flex;
  align-items: center;
  gap: 36px;
  padding-top: 28px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}
.hero-stats-glass .stat-item strong {
  display: block;
  font-size: 24px;
  font-weight: 800;
  color: #34d399;
  line-height: 1.2;
}
.hero-stats-glass .stat-item span {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 500;
}

/* Swiper Pagination */
.hero-swiper-pagination {
  position: absolute;
  bottom: 24px !important;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  z-index: 25;
}
.hero-swiper-pagination .swiper-pagination-bullet {
  width: 10px;
  height: 10px;
  background: rgba(255, 255, 255, 0.45) !important;
  border-radius: 9999px !important;
  opacity: 1 !important;
  cursor: pointer;
  transition: all .3s cubic-bezier(0.16, 1, 0.3, 1);
  margin: 0 4px !important;
}
.hero-swiper-pagination .swiper-pagination-bullet-active {
  width: 32px !important;
  background: #34d399 !important;
  box-shadow: 0 0 12px rgba(52, 211, 153, 0.6);
}

/* ============================================================
   SPOTLIGHT KAJIAN UTAMA (Moved and Adjusted to Full Width)
   ============================================================ */
.spotlight-card {
  background-color: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-lg);
  padding: 36px;
  box-shadow: var(--shadow-card);
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  align-items: center;
  gap: 36px;
  margin-bottom: 32px;
  transition: transform .2s ease, box-shadow .2s ease;
}
.spotlight-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
  border-color: var(--green-600);
}
.spotlight-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.spotlight-title {
  font-size: clamp(20px, 2.3vw, 25px);
  font-weight: 800;
  line-height: 1.35;
  color: var(--slate-900);
  margin-bottom: 14px;
}
.spotlight-title a:hover {
  color: var(--green-800);
}
.spotlight-summary {
  font-size: 15px;
  color: var(--slate-600);
  line-height: 1.68;
  margin-bottom: 20px;
}
.spotlight-author-box {
  background-color: var(--slate-50);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-md);
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16px;
}
.spotlight-author-info {
  display: flex;
  align-items: center;
  gap: 14px;
}
.hero-card-summary {
  font-size: 14.5px;
  color: var(--slate-600);
  line-height: 1.65;
  margin-bottom: 24px;
}
.hero-card-author {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--slate-100);
}
.author-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: var(--green-900);
  color: var(--amber-100);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 14px;
}
.author-info strong {
  display: block;
  font-size: 14px;
  color: var(--slate-900);
}
.author-info span {
  font-size: 12.5px;
  color: var(--slate-500);
}

/* ============================================================
   SECTIONS: GENERAL STYLES
   ============================================================ */
.section {
  padding: 72px 0;
}
.section-alt {
  background-color: var(--slate-50);
}
.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 40px;
}
.section-kicker {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--green-800);
  margin-bottom: 8px;
  display: block;
}
.section-title {
  font-size: clamp(26px, 3.2vw, 34px);
  font-weight: 800;
  letter-spacing: -0.025em;
  color: var(--slate-900);
  line-height: 1.25;
}
.section-subtitle {
  font-size: 15.5px;
  color: var(--slate-600);
  max-width: 540px;
  margin-top: 10px;
}

/* ============================================================
   FOUR PILLARS / FOKUS RISET
   ============================================================ */
.pillar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.pillar-card {
  background-color: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}
.pillar-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
  border-color: var(--green-600);
}
.pillar-num {
  font-size: 13px;
  font-weight: 800;
  color: var(--green-800);
  background-color: var(--green-50);
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}
.pillar-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--slate-900);
  margin-bottom: 10px;
  line-height: 1.35;
}
.pillar-desc {
  font-size: 14px;
  color: var(--slate-600);
  line-height: 1.6;
  margin-bottom: 20px;
}
.pillar-link {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--green-800);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

/* ============================================================
   ARTICLES GRID
   ============================================================ */
.articles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.article-card {
  background-color: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius-md);
  padding: 26px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}
.article-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-hover);
  border-color: var(--green-700);
}
.article-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.category-badge {
  font-size: 11.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .04em;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  background-color: var(--slate-100);
